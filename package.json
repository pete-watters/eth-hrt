  },
  "devDependencies": {
    "@leather.io/panda-preset": "^0.16.2",
    "@opennextjs/cloudflare": "^1.0.0",
    "@pandacss/dev": "^1.7.1",
    "tsx": "^4.19.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.86.0"
  }
